# Copy this file to .env and fill in your key
DEEPSEEK_API_KEY=your-key-here

# For a key from platform.deepseek.com, leave these two out.
# For an NVIDIA key (nvapi-...), use:
DEEPSEEK_BASE_URL=https://integrate.api.nvidia.com/v1
MODEL=deepseek-ai/deepseek-v4.1-flash

# Name shown in the top bar and browser tab
APP_NAME=AhmedGPT
PORT=3000

# Optional: backup model used if MODEL hasn't started answering within FALLBACK_AFTER seconds
FALLBACK_MODEL=openai/gpt-oss-20b
FALLBACK_AFTER=8
